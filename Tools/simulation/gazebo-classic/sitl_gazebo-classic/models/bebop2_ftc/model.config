<?xml version="1.0"?>
<model>
  <name>Bebop2 FTC</name>
  <version>1.0</version>
  <sdf version='1.6'>bebop2_ftc.sdf</sdf>

  <author>
   <name>PX4 FTC INDI experiment</name>
   <email>px4@example.com</email>
  </author>

  <description>
    Lightweight quadrotor model for single-rotor FTC INDI experiments based on
    the Bebop2 parameters reported by Sun et al. Visual meshes are scaled Iris
    assets; mass, inertia, rotor geometry and motor constants are tuned for the
    paper-structure controller tests.
  </description>
</model>
